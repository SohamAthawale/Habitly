# Copy to .env and adjust. Every variable is optional; defaults suit a single GPU box.
# Nothing here requires a paid service.

# ---------------------------------------------------------------- compose
# Uncomment on a machine without an NVIDIA GPU:
# COMPOSE_FILE=compose.yaml:compose.cpu.yaml
API_PORT=8000
WEB_PORT=3000

# ---------------------------------------------------------------- postgres / redis
POSTGRES_USER=roundtable
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roundtable
POSTGRES_PORT=5432          # host port, bound to 127.0.0.1 only
REDIS_PORT=6379             # host port, bound to 127.0.0.1 only
# Used when running the API outside Docker (compose sets these for the container):
DATABASE_URL=postgresql://roundtable:change-me@localhost:5432/roundtable
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- ollama (local, default)
OLLAMA_VERSION=0.40.2
OLLAMA_BASE_URL=http://localhost:11434   # outside Docker; compose overrides for the API
OLLAMA_PORT=11434
# Two different model families for diversity; both fit a 16 GB GPU at Q4 together.
OLLAMA_MODEL_PRIMARY=qwen3:8b
OLLAMA_MODEL_SECONDARY=llama3.1:8b
# Concurrency tuning (run `roundtable bench` to choose). KV cache memory scales with
# CONTEXT_LENGTH x NUM_PARALLEL per loaded model.
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_QUEUE=256

# ---------------------------------------------------------------- openrouter (free tier, optional)
# Get a key at https://openrouter.ai/keys. Leave empty to run fully local.
OPENROUTER_API_KEY=
# Free-tier limits: 20/min; 50/day (1000/day once an account has bought >= $10 credits).
OPENROUTER_RPM=20
OPENROUTER_RPD=50
# Free model ids change often; list current ones with:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id | select(endswith(":free"))'
OPENROUTER_MODEL_PRIMARY=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_SECONDARY=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- custom OpenAI-compatible endpoint (optional)
# vLLM, LM Studio, ScaleServe, ... Must expose /chat/completions and /models.
CUSTOM_PROVIDER_ENABLED=false
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_RPM=600

# ---------------------------------------------------------------- team limits
MAX_AGENTS=12
MAX_ROUNDS=2
REQUEST_BUDGET=60

# ---------------------------------------------------------------- tools (used from M5)
TAVILY_API_KEY=

# ---------------------------------------------------------------- api process
ROUNDTABLE_CONFIG=../config/roundtable.yaml   # relative to api/ when run outside Docker
LOG_LEVEL=INFO
LOG_JSON=true
