# Copy to .env and fill in. Never commit .env.

HOST=127.0.0.1
PORT=3000
BASE_PATH=/ibmz
PUBLIC_URL=https://sohamathawale.duckdns.org/ibmz
DB_PATH=./data/ibmz.db
CORS_ORIGIN=*

# Required for POST/DELETE. Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Discord Developer Portal -> your application
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Your server id (Discord: Settings -> Advanced -> Developer Mode, then right-click server -> Copy Server ID)
DISCORD_GUILD_ID=
# Optional: a permanent invite link to share, shown by /hub and GET /ibmz/
DISCORD_INVITE_URL=
DISCORD_STATE_PATH=./data/discord.json
# Password for the stats page (/ibmz/stats). Read-only, anonymous counts; keep ADMIN_API_KEY separate and strong.
STATS_PASSWORD=
